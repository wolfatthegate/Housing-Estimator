# Copy to .env and fill in. Every value here is optional — with none of them set,
# the app runs on the offline synthetic provider.

# --- Data source ----------------------------------------------------------
# auto (default) | rentcast | rapidapi | synthetic
# auto prefers rentcast, then rapidapi, then synthetic.
ZESTIMATE_PROVIDER=auto

# Licensed Zillow data API (RapidAPI). Without this, "auto" falls back to
# synthetic data. We do not scrape zillow.com — that breaks their ToS.
RAPIDAPI_KEY=
RAPIDAPI_HOST=zillow-com1.p.rapidapi.com

# RentCast: public-records data, so it returns recorded SALE prices rather than
# asking prices, and covers off-market homes. Free tier is 50 calls/month.
# https://developers.rentcast.io
RENTCAST_API_KEY=
RENTCAST_BASE_URL=https://api.rentcast.io/v1
# Ignore sales older than this many days. The model has no time feature, so an
# old price would be learned as if it closed today. 0 disables the filter.
RENTCAST_MAX_SALE_AGE_DAYS=1095

# --- Repeat-sales time adjustment ------------------------------------------
# Off by default. When on, two sales of the same home form a matched pair whose
# ratio measures local appreciation; the median rate restates older sales in
# today's dollars, so they can train the model instead of being discarded.
TIME_ADJUST_ENABLED=0
TIME_ADJUST_MAX_SALE_AGE_DAYS=3650
TIME_ADJUST_MIN_PAIRS=8
TIME_ADJUST_MIN_HOLD_YEARS=0.75
TIME_ADJUST_MAX_ANNUAL_RATE=0.35
TIME_ADJUST_MAX_FACTOR=2.0

# --- Geocoding ------------------------------------------------------------
# Nominatim asks for a descriptive User-Agent identifying your app + contact.
GEOCODER_USER_AGENT=zestimate/1.0 (you@example.com)

# --- Address verification (USPS) -------------------------------------------
# OAuth2 client credentials for the USPS Addresses API (developers.usps.com).
# Without both of these set, address verification is skipped and every
# address is treated as valid -- the app still works offline.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_BASE_URL=https://apis.usps.com

# --- Comparable selection -------------------------------------------------
SEARCH_RADIUS_MI=2.0
MAX_SEARCH_RADIUS_MI=8.0
MIN_TRAINING_ROWS=12
MAX_TRAINING_ROWS=250
N_COMPS_SHOWN=8

# --- Random forest --------------------------------------------------------
RF_N_ESTIMATORS=400
RF_MIN_SAMPLES_LEAF=2
RF_RANDOM_STATE=42

# --- Server ---------------------------------------------------------------
# Only used by `python app.py` locally. In production gunicorn binds the port
# itself (see the Dockerfile) and these are ignored.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
